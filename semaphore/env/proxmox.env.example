# Semaphore Environment "proxmox-lab" - the four Proxmox API variables.
#
# In Semaphore: Project -> Environment -> New Environment, name it
# "proxmox-lab", paste this JSON (with real values), and attach it to the
# deploy task template. 00_provision_vm.yml reads exactly these names via
# lookup('env', ...) - the token then never appears in git, in the repo,
# or in task logs (Semaphore masks Environment values marked as secrets).
#
# The token itself: created in phase 1 (scripts/pve-bootstrap.sh) as
# terraform@pve!provider. Reusing it is the lab-quick path; the cleaner
# habit is a second token on the same user so each tool can be revoked
# independently:
#   pveum user token add terraform@pve semaphore --privsep 0
#   (then the value below becomes that token's UUID)

{
  "PROXMOX_HOST": "192.168.122.11",
  "PROXMOX_PORT": "8006",
  "PROXMOX_USER": "terraform@pve",
  "PROXMOX_TOKEN_ID": "provider",
  "PROXMOX_TOKEN_SECRET": "PASTE-THE-TOKEN-UUID-HERE"
}
